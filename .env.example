# Gemini generation runs from the RAG backend; never expose this key to browsers.
GEMINI_API_KEY=
RAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RAG_LLM_API_KEY=
RAG_LLM_MODEL=gemini-3.8-flash
# Optional separate embedding key; falls back to RAG_LLM_API_KEY.
RAG_EMBEDDING_API_KEY=
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_PORT=8000
RAG_ENV=development
# Generate independent 32+ character secrets. Never put these in browser code.
RAG_API_KEY=
RAG_ADMIN_API_KEY=
RAG_MAX_UPLOAD_BYTES=26214400
RAG_DATA_DIR=./data
RAG_PROJECTS_DIR=./projects
RAG_AGENTS_DIR=./agents
# Optional cache settings for projects using local Sentence Transformers models.
HF_HOME=./data/hf-cache
HF_HUB_CACHE=./data/hf-cache/hub
# Optional: path to tesseract executable for OCR fallback
TESSERACT_CMD=
